{
  "compilerOptions": {
    "composite": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "outDir": "dist-tests",
    "lib": ["ES2022"],
    "types": ["node"],
    "skipLibCheck": true,
    "sourceMap": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "tests",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["tests"],
  "exclude": ["node_modules"],
  "references": [
    { "path": "./tsconfig.src.json" }
  ]
}
