<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.9.5</Version>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>AutoContext.Engine.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.6.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AutoContext.Engine.Core\AutoContext.Engine.Core.csproj" />
    <ProjectReference Include="..\AutoContext.Engine.Tests.Support\AutoContext.Engine.Tests.Support.csproj" />
    <!-- Build-time-only: the smoke tests in this project spawn the engine
         binary, so its build must be sequenced ahead of theirs.
         ReferenceOutputAssembly=false keeps the binary off the reference set. -->
    <ProjectReference Include="..\..\src\AutoContext.Engine\AutoContext.Engine.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true"
                      UndefineProperties="TargetFramework" />
  </ItemGroup>

  <!-- Link the real bundled MCP-tools side-cars (registry schema plus the catalog
       and its schema) into the test output so the fixtures validate against the
       shipped contracts instead of verbatim copies that could silently drift.
       McpToolsRegistryTestFiles reads them from AppContext.BaseDirectory/Resources
       at run time. -->
  <ItemGroup>
    <Content Include="..\..\src\AutoContext.Engine\Resources\mcp-tools-registry.schema.json"
             Link="Resources\mcp-tools-registry.schema.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\AutoContext.Engine\Resources\mcp-tools-catalog.json"
             Link="Resources\mcp-tools-catalog.json"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\src\AutoContext.Engine\Resources\mcp-tools-catalog.schema.json"
             Link="Resources\mcp-tools-catalog.schema.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
