{
  "name": "autocontext-nodejs-core",
  "version": "0.9.5",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#types/*.js": {
      "types": "./src/types/*.ts",
      "default": "./dist/types/*.js"
    },
    "#support/*": "./tests/support/*",
    "#src/*": "./src/*"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "autocontext-nodejs-tests-support": "file:../../tests/AutoContext.Nodejs.Tests.Support"
  }
}
