<Project>

  <!--
    Generates the wire-shape Resources/instructions-files.json catalogue from the
    curated instruction corpus. Imported by AutoContext.Engine.csproj because the
    engine binary host owns the output Resources/ folder. The task assembly is
    built by the ProjectReference the engine declares to AutoContext.Build.Tasks
    (ReferenceOutputAssembly=false), so it exists by the time this target runs.
  -->

  <PropertyGroup>
    <_InstructionsListBuilderAssembly Condition="'$(_InstructionsListBuilderAssembly)' == ''">$(MSBuildThisFileDirectory)bin\$(Configuration)\netstandard2.0\AutoContext.Build.Tasks.dll</_InstructionsListBuilderAssembly>
  </PropertyGroup>

  <UsingTask
      TaskName="AutoContext.Build.Tasks.BuildInstructionsListTask"
      AssemblyFile="$(_InstructionsListBuilderAssembly)" />

  <Target Name="GenerateInstructionsFilesManifest"
          AfterTargets="ResolveProjectReferences"
          BeforeTargets="CoreCompile">
    <BuildInstructionsListTask
        CorpusDirectory="$(MSBuildProjectDirectory)\Instructions"
        OutputPath="$(MSBuildProjectDirectory)\Resources\instructions-files.json" />
  </Target>

</Project>
