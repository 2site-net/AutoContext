<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.9.5</Version>
    <!-- netstandard2.0: MSBuild ITask implementations must load under both
         MSBuild-Full-Framework and MSBuild-Core. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- netstandard2.0 defaults to C# 7.3; opt into a modern language version
         so the repo-wide Nullable/ImplicitUsings analyzer settings apply. -->
    <LangVersion>latest</LangVersion>
    <RootNamespace>AutoContext.Build.Tasks</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- Build-time-only tasks: never shipped with the engine runtime. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="17.14.28" ExcludeAssets="Runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" ExcludeAssets="Runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
