<Project>

  <!--
    Generates the Resources/workers.json manifest from the per-worker
    .autocontext-worker.json descriptors under the src/AutoContext.Worker.*
    projects by running the AutoContext.Workers.Manifest.Generator console tool. The
    worker directories are scanned, not built — only each project's hand-authored
    .autocontext-worker.json descriptor is read. Imported by AutoContext.Engine.csproj
    because the engine binary host owns the output Resources/ folder. The generator
    assembly is built by the ProjectReference the engine declares to
    AutoContext.Workers.Manifest.Generator (ReferenceOutputAssembly=false), so it
    exists by the time this target runs.
  -->

  <PropertyGroup>
    <_WorkersManifestGeneratorAssembly Condition="'$(_WorkersManifestGeneratorAssembly)' == ''">$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\workers-manifest-gen.dll</_WorkersManifestGeneratorAssembly>
  </PropertyGroup>

  <Target Name="GenerateWorkersManifest"
          AfterTargets="ResolveProjectReferences"
          BeforeTargets="CoreCompile">
    <Exec Command="dotnet &quot;$(_WorkersManifestGeneratorAssembly)&quot; &quot;$(MSBuildProjectDirectory)\..&quot; &quot;$(MSBuildProjectDirectory)\Resources\workers.json&quot;" />
  </Target>

</Project>
