<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.9.5</Version>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AutoContext.Engine</RootNamespace>
    <AssemblyName>autocontext-engine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AutoContext.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoContext.Engine.Core\AutoContext.Engine.Core.csproj" />
    <!-- Build-time-only: provides the BuildInstructionsListTask used by the
         imported targets below. ReferenceOutputAssembly=false keeps the
         netstandard2.0 task assembly off the engine's runtime reference set
         while still ordering its build before the engine's. -->
    <ProjectReference Include="..\AutoContext.Build.Tasks\AutoContext.Build.Tasks.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true"
                      UndefineProperties="TargetFramework" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="System.CommandLine" Version="2.0.8" />
  </ItemGroup>

  <Import Project="..\AutoContext.Build.Tasks\InstructionsListBuilder.targets" />

</Project>
