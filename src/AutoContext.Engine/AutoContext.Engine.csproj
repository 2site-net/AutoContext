<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.9.5</Version>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AutoContext.Engine</RootNamespace>
    <AssemblyName>autocontext-engine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AutoContext.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoContext.Engine.Core\AutoContext.Engine.Core.csproj" />
    <!-- Build-time-only: the console generator the imported targets invoke to
         emit Resources/instructions-manifest.json. ReferenceOutputAssembly=false
         keeps the generator off the engine's runtime reference set while still
         ordering its build before the engine's. -->
    <ProjectReference Include="..\AutoContext.Instructions.Manifest.Generator\AutoContext.Instructions.Manifest.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true"
                      UndefineProperties="TargetFramework" />
    <!-- Build-time-only: the console generator the imported targets invoke to
         emit Resources/workers.json by aggregating the per-worker
         .autocontext-worker.json descriptors under src/AutoContext.Worker.*.
         ReferenceOutputAssembly=false keeps the generator off the
         engine's runtime reference set while still ordering its build before
         the engine's. -->
    <ProjectReference Include="..\AutoContext.Workers.Manifest.Generator\AutoContext.Workers.Manifest.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true"
                      UndefineProperties="TargetFramework" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="System.CommandLine" Version="2.0.8" />
  </ItemGroup>

  <!-- Ship the build-time instruction side-cars beside the engine binary so
       InstructionsManifestService can load them from AppContext.BaseDirectory/Resources
       at startup. The hand-authored catalog is tracked; the generator (imported below)
       writes the manifest during the build, so it may not exist at evaluation time; an
       explicit Include of the literal paths still registers the copy items, and the
       Remove first drops the duplicate the SDK's default None glob would add on an
       incremental build. -->
  <ItemGroup>
    <None Remove="Resources\instructions-catalog.json" />
    <None Remove="Resources\instructions-manifest.json" />
    <None Include="Resources\instructions-catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\instructions-manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ship the hand-authored MCP-tools registry and its JSON schema beside the
       engine binary so McpToolsRegistryLoader can read them from
       AppContext.BaseDirectory/Resources at startup. -->
  <ItemGroup>
    <None Remove="Resources\mcp-tools-registry.json" />
    <None Remove="Resources\mcp-tools-registry.schema.json" />
    <None Include="Resources\mcp-tools-registry.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\mcp-tools-registry.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ship the hand-authored MCP-tools catalog and its JSON schema beside the
       engine binary so the catalog loader can read them from
       AppContext.BaseDirectory/Resources at startup. The catalog is the
       curatorial taxonomy (category tree + per-tool entries); conceptually
       similar to instructions-catalog.json, but its own shape. -->
  <ItemGroup>
    <None Remove="Resources\mcp-tools-catalog.json" />
    <None Remove="Resources\mcp-tools-catalog.schema.json" />
    <None Include="Resources\mcp-tools-catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\mcp-tools-catalog.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ship the build-generated worker manifest beside the engine binary so the
       worker resolver can read it from AppContext.BaseDirectory/Resources at
       startup. The generator (imported below) writes it during the build, so it
       may not exist at evaluation time; an explicit Include of the literal path
       still registers the copy item, and the Remove first drops the duplicate
       the SDK's default None glob would add on an incremental build. -->
  <ItemGroup>
    <None Remove="Resources\workers.json" />
    <None Include="Resources\workers.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ship the curated instruction corpus bodies beside the engine binary so
       InstructionsBodyProjector and InstructionsFullTextSearchService can read
       the bundled body text from AppContext.BaseDirectory/Instructions
       at runtime for the Instructions.Get/GetAll/GetRaw/SearchContent handlers.
       The corpus is authored content, not a generated manifest, so it sits at
       the bundle root beside Resources/ and Workers/ rather than inside them.
       The Remove first drops the duplicate the SDK's default None glob would add,
       then the Link flattens each corpus file into that one directory. -->
  <ItemGroup>
    <None Remove="Instructions\*.instructions.md" />
    <None Include="Instructions\*.instructions.md"
          Link="Instructions\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\AutoContext.Instructions.Manifest.Generator\InstructionsManifestGenerator.targets" />
  <Import Project="..\AutoContext.Workers.Manifest.Generator\WorkersManifestGenerator.targets" />

</Project>
