<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.9.5</Version>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AutoContext.Engine</RootNamespace>
    <AssemblyName>autocontext-engine</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AutoContext.Engine.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoContext.Engine.Core\AutoContext.Engine.Core.csproj" />
    <!-- Build-time-only: the console generator the imported targets invoke to
         emit Resources/instructions-manifest.json. ReferenceOutputAssembly=false
         keeps the generator off the engine's runtime reference set while still
         ordering its build before the engine's. -->
    <ProjectReference Include="..\AutoContext.Instructions.Manifest.Generator\AutoContext.Instructions.Manifest.Generator.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      SkipGetTargetFrameworkProperties="true"
                      UndefineProperties="TargetFramework" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageReference Include="System.CommandLine" Version="2.0.8" />
  </ItemGroup>

  <!-- Ship the build-time instruction side-cars beside the engine binary so
       InstructionsManifestService can load them from AppContext.BaseDirectory/Resources
       at startup. The hand-authored catalog is tracked; the generator (imported below)
       writes the manifest during the build, so it may not exist at evaluation time; an
       explicit Include of the literal paths still registers the copy items, and the
       Remove first drops the duplicate the SDK's default None glob would add on an
       incremental build. -->
  <ItemGroup>
    <None Remove="Resources\instructions-catalog.json" />
    <None Remove="Resources\instructions-manifest.json" />
    <None Include="Resources\instructions-catalog.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Resources\instructions-manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ship the curated instruction corpus bodies beside the engine binary so
       InstructionsBodyProjector and InstructionsFullTextSearchService can read
       the bundled body text from AppContext.BaseDirectory/Resources/Instructions
       at runtime for the Instructions.Get/GetAll/GetRaw/SearchContent handlers.
       The Remove first drops the duplicate the SDK's default None glob would add,
       then the Link redirects each flat corpus file under the Resources subtree. -->
  <ItemGroup>
    <None Remove="Instructions\*.instructions.md" />
    <None Include="Instructions\*.instructions.md"
          Link="Resources\Instructions\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\AutoContext.Instructions.Manifest.Generator\InstructionsManifestGenerator.targets" />

</Project>
