{
  "name": "autocontext-worker-web",
  "version": "0.9.5",
  "type": "module",
  "private": true,
  "imports": {
    "#types/*.js": {
      "types": "./src/types/*.ts",
      "default": "./dist/types/*.js"
    },
    "#support/*": "./tests/support/*",
    "#src/*": "./src/*"
  },
  "scripts": {
    "prebuild": "pwsh ../../scripts/versionize.ps1 Export src/version.ts",
    "build": "tsc -b tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "autocontext-nodejs-core": "file:../AutoContext.Nodejs.Core",
    "typescript": "^5.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "vitest": "^4.1.0"
  }
}
