<Project>

  <!--
    Generates the Resources/instructions-manifest.json fact index from the curated
    instruction corpus and the hand-authored Resources/instructions-catalog.json by
    running the AutoContext.Instructions.Manifest.Generator console tool. The
    catalog is a tracked input the generator only reads (to cross-validate it
    against the corpus); the manifest is the generated output. Imported by
    AutoContext.Engine.csproj because the engine binary host owns the output
    Resources/ folder. The generator assembly is built by the ProjectReference the
    engine declares to AutoContext.Instructions.Manifest.Generator
    (ReferenceOutputAssembly=false), so it exists by the time this target runs.
  -->

  <PropertyGroup>
    <_InstructionsManifestGeneratorAssembly Condition="'$(_InstructionsManifestGeneratorAssembly)' == ''">$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\instructions-manifest-gen.dll</_InstructionsManifestGeneratorAssembly>
  </PropertyGroup>

  <Target Name="GenerateInstructionsFilesManifest"
          AfterTargets="ResolveProjectReferences"
          BeforeTargets="CoreCompile">
    <Exec Command="dotnet &quot;$(_InstructionsManifestGeneratorAssembly)&quot; &quot;$(MSBuildProjectDirectory)\Instructions&quot; &quot;$(MSBuildProjectDirectory)\Resources\instructions-catalog.json&quot; &quot;$(MSBuildProjectDirectory)\Resources\instructions-manifest.json&quot;" />
  </Target>

</Project>
