<Project>

  <!--
    Generates the wire-shape Resources/instructions-files.json catalogue and its
    section-indexed Resources/instructions-files-metadata.json companion from the
    curated instruction corpus by running the
    AutoContext.Instructions.Manifest.Generator console tool. Imported by
    AutoContext.Engine.csproj because the engine binary host owns the output
    Resources/ folder. The generator assembly is built by the ProjectReference the
    engine declares to AutoContext.Instructions.Manifest.Generator
    (ReferenceOutputAssembly=false), so it exists by the time this target runs.
  -->

  <PropertyGroup>
    <_InstructionsManifestGeneratorAssembly Condition="'$(_InstructionsManifestGeneratorAssembly)' == ''">$(MSBuildThisFileDirectory)bin\$(Configuration)\net10.0\instructions-manifest-gen.dll</_InstructionsManifestGeneratorAssembly>
  </PropertyGroup>

  <Target Name="GenerateInstructionsFilesManifest"
          AfterTargets="ResolveProjectReferences"
          BeforeTargets="CoreCompile">
    <Exec Command="dotnet &quot;$(_InstructionsManifestGeneratorAssembly)&quot; &quot;$(MSBuildProjectDirectory)\Instructions&quot; &quot;$(MSBuildProjectDirectory)\Resources\instructions-files.json&quot; &quot;$(MSBuildProjectDirectory)\Resources\instructions-files-metadata.json&quot;" />
  </Target>

</Project>
