<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>0.9.5</Version>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AutoContext.Framework.Workers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AutoContext.Framework.Workers.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AutoContext.Framework.Pipes\AutoContext.Framework.Pipes.csproj" />
    <ProjectReference Include="..\AutoContext.Framework.Logging\AutoContext.Framework.Logging.csproj" />
    <ProjectReference Include="..\AutoContext.Engine.Protocol\AutoContext.Engine.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Framework.Workers owns the standard worker-host bootstrap
      (WorkerHostBuilderExtensions.ConfigureWorkerHost) that wires the
      service-address switches, the in-memory ready marker, and
      WorkerHostOptions binding. The full Microsoft.Extensions.Hosting
      package is required for HostApplicationBuilder and the
      configuration extensions (AddCommandLine, AddInMemoryCollection,
      services.Configure&lt;T&gt;(IConfiguration)); it transitively brings in
      Hosting.Abstractions, Logging.Abstractions, and Options.
    -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
  </ItemGroup>

</Project>
